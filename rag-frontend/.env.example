# ══════════════════════════════════════════════
#  RAG AI — Environment Variables
#  Copy this to .env and fill in your values
# ══════════════════════════════════════════════

# Set to "true" to use mock data (no backend needed)
# Set to "false" when connecting real backend
VITE_USE_MOCK=false

# Your backend API base URL
# Change this to your Spring Boot / FastAPI URL
VITE_API_URL=/api
